{
  "name": "personal-website",
  "version": "1.0.0",
  "description": "Personal portfolio for Jeton Gjonbalaj.",
  "scripts": {
    "css:watch": "tailwindcss -i ./src/input.css -o ./assets/styles.css --watch",
