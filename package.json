  },
  "homepage": "https://github.com/JetonGjonbalaj/personal-website#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.4",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3"
  }
}
